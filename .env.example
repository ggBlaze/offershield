# OfferShield — Environment Variables
# ---------------------------------------------------------------
# All variables are optional. If AI_API_KEY is missing, OfferShield
# serves a high-fidelity mock response so the app is instantly
# demoable without any keys configured.
# ---------------------------------------------------------------

# Your provider API key. For MiniMax, this is the sk-cp-... key.
AI_API_KEY=

# The base URL of the Anthropic-compatible endpoint.
# Defaults to MiniMax's Anthropic-compatible endpoint.
AI_BASE_URL=https://api.minimax.io/anthropic

# The model name to use.
AI_MODEL=MiniMax-M3

# Google Analytics 4 measurement ID (e.g. G-LGRL6X71SJ).
# If unset, the analytics script is not loaded at all.
#
# This is the only env var exposed to the browser (the
# NEXT_PUBLIC_ prefix is the Next.js convention for client-side
# env vars). Safe to commit .env.example with an empty value;
# the real value is set per-environment (Vercel / Coolify
# dashboard) and lives in .env.local / .env.production which
# are gitignored.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
